# Kopiera denna fil till .env och fyll i egna, hemliga värden innan du kör
# docker compose up. Committa aldrig den riktiga .env-filen till git.

# Databas
POSTGRES_DB=minadjur
POSTGRES_USER=minadjur
POSTGRES_PASSWORD=byt-ut-mig-till-ett-starkt-losenord

# Använd t.ex. `openssl rand -hex 32` för att generera en slumpad hemlighet
SESSION_SECRET=byt-ut-mig-till-en-lang-slumpad-strang

# Sätt till true ENDAST om du kör appen bakom en HTTPS-reverse proxy
# (t.ex. Nginx/Traefik med TLS-certifikat). Kör du bara på http://din-host:port
# utan TLS ska den vara false, annars fungerar inte inloggningen.
COOKIE_SECURE=false

# Porten på din Docker-host som appen ska exponeras på
APP_PORT=4300
